load("@rules_fuzzing//fuzzing:cc_defs.bzl", "cc_fuzz_test")
load("@properties//:properties.bzl", "PROPERTIES")

FAAD_DEFINES = [
    "FAAD2_VERSION=\\\"%s\\\"" % PROPERTIES["PACKAGE_VERSION"],
]

cc_library(
    name = "faad",
    srcs = ["libfaad/shim.c"],
    hdrs = ["include/neaacdec.h"],
    copts = ["-Wall", "-Wextra", "-pedantic"],
    local_defines = FAAD_DEFINES,
    deps = ["@faac//:faad3"],
    strip_include_prefix = "include",
)

# The compatibility API now has one implementation; keep the historic labels
# available for downstream BUILD files.
[
    cc_library(name = target, deps = [":faad"])
    for target in ["faad_drm", "faad_fixed", "faad_drm_fixed"]
]

cc_fuzz_test(
    name = "fuzz_config",
    srcs = ["fuzz/fuzz_config.c"],
    deps = [":faad"],
)

cc_fuzz_test(
    name = "fuzz_decode",
    srcs = ["fuzz/fuzz_decode.c"],
    deps = [":faad"],
)

cc_library(
    name = "shim_test_headers",
    hdrs = glob(["tests/layout*.inc"]),
    includes = ["tests"],
)

cc_test(
    name = "shim_test",
    srcs = ["tests/shim_test.c"],
    args = ["tests/data"],
    data = glob(["tests/data/**"]),
    deps = [":faad", ":shim_test_headers"],
)
